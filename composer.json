{
  "name": "orion/telemetry-workbench",
  "description": "ORION Telemetry & Digital Twin Workbench PHP Backend API (dipo_api) & Heroku Static/SPA Host",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "scripts": {
