# ORION Backend PHP Configuration Template (copy to `.env` on VPS / Shared Hosting)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dipo_telemetry
DB_USER=root
DB_PASS=

# Optional shared secret token for ESP32 X-Node-Token header
# NODE_AUTH_TOKEN=replace-with-strong-secret

# Restrict dashboard CORS origin in production (e.g. https://orion-yard.yourdomain.com)
CORS_ALLOWED_ORIGIN=*

